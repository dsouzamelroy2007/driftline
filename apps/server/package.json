    "@fastify/cors": "^10.0.2",
    "@fastify/rate-limit": "^10.2.2",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.38.3",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "ioredis": "^5.4.2",
    "jose": "^5.9.6",
    "resend": "^4.1.1",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
