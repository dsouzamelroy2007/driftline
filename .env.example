# Copy to .env and fill in real values. .env is gitignored.

# Neon Postgres pooled connection string (neon.tech dashboard -> Connection Details)
DATABASE_URL=postgres://user:password@ep-example.neon.tech/driftline?sslmode=require

# Upstash Redis-protocol (rediss://) connection string, not the REST URL
REDIS_URL=rediss://default:password@example.upstash.io:6379

# Random secret for signing access tokens (openssl rand -hex 32), min 32 chars
JWT_SECRET=

JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# Origin the web client is served from (CORS allowlist)
WEB_ORIGIN=http://localhost:3000

# Public host this server instance registers in the service-discovery registry
DISCOVERY_HOST=http://localhost:4000

# This server's own public URL — used to build the GitHub OAuth redirect URI
SERVER_PUBLIC_URL=http://localhost:4000

PORT=4000

# Resend (resend.com -> Settings -> API Keys)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Driftline <onboarding@resend.dev>

# GitHub OAuth App (github.com/settings/developers -> OAuth Apps)
# Authorization callback URL must be ${SERVER_PUBLIC_URL}/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# docs/RETENTION.md global constants — do not make these per-conversation without a new ADR
RETENTION_WINDOW_DAYS=30
DEVICE_DORMANCY_DAYS=30

# apps/web only — the server's own HTTP + Socket.IO origin, used by the browser client
NEXT_PUBLIC_SERVER_URL=http://localhost:4000

# Cloudflare R2 (dash.cloudflare.com -> R2 Object Storage -> Manage R2 API Tokens).
# Attachments are uploaded AND downloaded directly browser<->R2 via short-lived presigned URLs —
# bytes never pass through this server — and R2 objects are deleted in lockstep with their
# envelope's purge (docs/ADR/0009-media-attachments.md). The bucket needs a CORS policy allowing
# BOTH PUT (upload) and GET (download) from WEB_ORIGIN, set in the R2 dashboard (Bucket -> Settings
# -> CORS Policy) — e.g. {"AllowedOrigins": ["http://localhost:3000"], "AllowedMethods": ["PUT",
# "GET"], "AllowedHeaders": ["content-type"], "MaxAgeSeconds": 3000}. Missing GET here is a real
# live-caught mistake (see ADR-0009's Phase 6 status notes) — don't repeat it.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
