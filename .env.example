# Copy to .env and fill in real values. .env is gitignored.

# Neon Postgres pooled connection string (neon.tech dashboard -> Connection Details)
DATABASE_URL=postgres://user:password@ep-example.neon.tech/driftline?sslmode=require

# Upstash Redis-protocol (rediss://) connection string, not the REST URL
REDIS_URL=rediss://default:password@example.upstash.io:6379

# Random secret for signing access tokens (openssl rand -hex 32), min 32 chars
JWT_SECRET=

JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# Origin the web client is served from (CORS allowlist)
WEB_ORIGIN=http://localhost:3000

# Public host this server instance registers in the service-discovery registry
DISCOVERY_HOST=http://localhost:4000

# This server's own public URL — used to build the GitHub OAuth redirect URI
SERVER_PUBLIC_URL=http://localhost:4000

PORT=4000

# Resend (resend.com -> Settings -> API Keys)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Driftline <onboarding@resend.dev>

# GitHub OAuth App (github.com/settings/developers -> OAuth Apps)
# Authorization callback URL must be ${SERVER_PUBLIC_URL}/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
